APP_NAME="Sistem K3 Monitoring"
APP_ENV=local
APP_KEY=                          # will be auto-generated on first docker compose up
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# ── Database ──────────────────────────────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=k3_db
DB_USERNAME=k3user
DB_PASSWORD=k3pass

# ── Session / Sanctum ─────────────────────────────────────────────────────────
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,127.0.0.1,127.0.0.1:8000

# ── Cache / Queue ─────────────────────────────────────────────────────────────
CACHE_STORE=file
QUEUE_CONNECTION=sync

# ── Integrasi TIF (X-Service-Key header) ─────────────────────────────────────
TIF_SERVICE_KEY=GANTI_DENGAN_KEY_YANG_DISEPAKATI_TIF

# ── Service Key (shared antara Laravel + Detection Worker) ────────────────────
# Digunakan untuk:
#   - Detection Worker → Laravel (POST /api/violations, GET /api/cameras/{id}/config)
#   - Laravel → Detection Worker (POST /api/cameras/{id}/reload, dll)
# Buat string acak panjang, contoh: openssl rand -hex 32
SERVICE_KEY=GANTI_DENGAN_SECRET_KEY_PANJANG_ACAK

# ── Detection Worker ──────────────────────────────────────────────────────────
# URL detection worker (dari sudut pandang Laravel/Nginx container)
DETECTION_WORKER_URL=http://detection_worker:8000
# URL Laravel dari sudut pandang detection_worker container
LARAVEL_URL=http://nginx:80
# Timeout (detik) saat Laravel memanggil detection worker
DETECTION_WORKER_TIMEOUT=5

# ── Telegram Notifications ───────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_MANAGER_CHAT_ID=
TELEGRAM_HR_CHAT_ID=

# ── Redis (untuk cache & broadcast events) ───────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=null

# ── Broadcasting (opsional — untuk real-time via WebSocket) ──────────────────
BROADCAST_CONNECTION=log
# Ganti ke "reverb" jika ingin menggunakan Laravel Reverb WebSocket:
# BROADCAST_CONNECTION=reverb
# REVERB_APP_ID=k3monitor
# REVERB_APP_KEY=k3monitor-key
# REVERB_APP_SECRET=k3monitor-secret
# REVERB_HOST=localhost
# REVERB_PORT=8080
# REVERB_SCHEME=http

# ── Misc ──────────────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local
MAIL_MAILER=log
